<?xml version="1.0" encoding="utf-8"?>
<!-- An unpackaged WinUI3 process needs this much said about it: which Windows
     it was tested against, and that it handles per-monitor DPI itself. Without
     the first, the framework refuses to consider the process a current-Windows
     one; without the second, the window is bitmap-stretched on a scaled
     display. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="sample.titlebar-probe"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <maxversiontested Id="10.0.22621.0"/>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
