// wxl::highlight -- syntax highlighting: splits source text into keyword, string,
// comment and plain pieces according to a language table. No regular expressions
// are used: wxl has none, and none are needed here -- a comment has an opening and
// a closing sequence, a string has a quote and an escape character, a keyword has
// boundaries, and this is sufficient for every built-in language.
//
// A comment takes one of three forms, all described by the same two sequences: to
// the end of the line (empty close), inline (open and close anywhere), and
// line-based, where open stands only at the start of a line and the comment ends
// right after close, wherever close stands (line_start_only, as =begin in Ruby).
//
// The module does not assign colors: it returns pieces and their kinds, and the
// code that draws them chooses the color of each kind. The language definitions are
// in src/languages.cpp, generated by tools/import-syntax.ps1 from the RsdnFormatter
// tables and from the tables in tools/syntax. The structures are exported, and a
// caller describes a language missing from the tables with them.

export module wxl.highlight;

import std;

export namespace wxl::highlight {

/// Specifies the kind of a piece of code, as far as highlighting distinguishes it.
enum class kind_t : std::uint8_t { plain, keyword, string, comment };

/// Represents a piece of code: a view into the source text and its kind. Pieces are
/// returned in order and cover the input without gaps, so concatenating their texts
/// yields the input.
struct piece {
    /// The text of the piece, a view into the code passed to the scanner.
    std::u16string_view text;
    /// The kind of the piece.
    kind_t kind;
};

/// Specifies the boundary at which a keyword is recognized. The values are those of
/// RsdnFormatter, where they replace boundary regular expressions: `word` is the usual
/// `\b`, `dot` marks assembler directives (`.model`), `hash_with_space` the preprocessor
/// (`# define`), `open_paren` Lisp forms (`(defun`), and `exclamation_and_word` Rust
/// macros (`assert!`, with the exclamation mark included in the piece).
enum class boundary_t : std::uint8_t {
    none,
    word,
    dot,
    dot_or_word,
    hash_with_space,
    at_or_word,
    dot_or_at_or_word,
    double_question,
    not_ampersand,
    word_or_double_question,
    exclamation_and_word,
    open_paren,
};

/// Represents a rule for a comment or a string delimited by an opening and a closing sequence.
struct delimited_rule {
    kind_t kind;                   ///< the kind of a piece this rule finds
    std::u16string_view open;      ///< the opening sequence
    std::u16string_view close;     ///< the closing sequence; empty: the piece ends with the line
    std::u16string_view prefixes;  ///< characters one of which may precede `open`: `u"..."` in
                                   ///< Python; the digit 8 in the list also allows the
                                   ///< two-character `u8"..."` of C++. A prefix starts a word:
                                   ///< inside an identifier it does not open a string
    char16_t escape;               ///< the escape character inside; 0 if there is none
    bool doubled_close;            ///< a doubled `close` inside does not end the piece: `'it''s'`
    bool multiline;                ///< the piece may cross a line break; otherwise it ends there
    bool line_start_only;          ///< `open` only at the start of a line: `=begin` in Ruby
    bool single_char;              ///< one character or one escape sequence inside (a character
                                   ///< literal), so that a Rust lifetime `'a` opens no string
    bool after_space;              ///< `open` only at the start of a line or after white space:
                                   ///< the shell `#`, not a comment in `${name#pattern}` or `$#`
};

/// Represents a set of keywords that share boundaries. `words` is sorted by code units, since
/// the scanner uses binary search, and holds lowercase words for a case-insensitive language.
struct keyword_set {
    /// The boundary the scanner checks before a word.
    boundary_t prefix;
    /// The boundary the scanner checks after a word.
    boundary_t postfix;
    /// The keywords of the set.
    std::span<const std::u16string_view> words;
    std::size_t longest;  ///< the length of the longest word; the scanner reads no further
};

/// Represents a language: the rules for comments and strings and the keyword sets, each in
/// order of precedence.
struct language {
    /// The name of the language, for example `CSharp`.
    std::u16string_view name;
    /// Specifies that keywords are compared without regard to case: ASCII letters of the code
    /// are converted to lowercase before the search.
    bool case_insensitive;
    /// The rules for comments and strings; at each position the first matching rule applies.
    std::span<const delimited_rule> delimiters;
    /// The keyword sets; at each position the first set that contains a word with matching
    /// boundaries applies.
    std::span<const keyword_set> keywords;
};

/// Returns the language for the name of a code tag, regardless of case: `c#`, `cs` and
/// `csharp` all name C#. Returns `nullptr` for an unknown name, including `code` itself,
/// which names no language.
const language* find_language(std::u16string_view tag) noexcept;

/// Returns all built-in languages.
std::span<const language> languages() noexcept;

/// Splits code into pieces one at a time without allocating memory: each piece is a view into
/// `code` and is valid as long as `code` is.
///
/// At each position a comment or a string takes precedence over a keyword, and a keyword over
/// plain text, so a keyword inside a string remains part of the string.
class scanner {
public:
    /// Constructs a scanner that splits `code` into pieces by the rules of `language`. Neither
    /// `language` nor `code` is copied.
    inline scanner(const language& language, std::u16string_view code) noexcept
        : language_(&language), code_(code) {}

    /// Returns the next piece, or `std::nullopt` at the end of the code.
    std::optional<piece> next() noexcept;

private:
    struct found {
        std::size_t end;
        kind_t kind;
    };

    std::optional<found> probe(std::size_t at) const noexcept;
    std::optional<found> delimited_at(std::size_t at) const noexcept;
    std::optional<found> keyword_at(std::size_t at) const noexcept;
    std::size_t delimited_end(const delimited_rule& rule, std::size_t at) const noexcept;

    const language* language_;
    std::u16string_view code_;
    std::size_t pos_ = 0;

    // The probe made while finding the end of a plain piece: the next call starts at that
    // position and reuses it.
    std::size_t probed_at_ = std::u16string_view::npos;
    std::optional<found> probed_;
};

}  // namespace wxl::highlight
