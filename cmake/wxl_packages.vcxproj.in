<?xml version="1.0" encoding="utf-8"?>
<!--
  The helper project of cmake/wxl_packages.cmake, written from cmake/wxl_packages.vcxproj.in
  into the build directory at configure. It has no sources. MSBuild restores its
  PackageReference items and then builds the C++/WinRT projection with the targets that the
  Microsoft.Windows.CppWinRT package imports into it.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <!-- What the machine adds to every project is switched off, so that the restore and the
         projection depend on this file alone: the vcpkg integration that `vcpkg integrate
         install` imports into each .vcxproj, and Directory.Build.props, Directory.Build.targets
         and Directory.Packages.props found in a directory above the build directory. -->
    <VcpkgEnabled>false</VcpkgEnabled>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
    <!-- The toolset and the Windows SDK of the developer environment that runs the configure,
         the same ones the compiler of the tree uses. -->
    <VCToolsVersion>@WXL_PACKAGES_VC_TOOLS_VERSION@</VCToolsVersion>
    <WindowsTargetPlatformVersion>@WXL_PACKAGES_WINDOWS_SDK_VERSION@</WindowsTargetPlatformVersion>
    <!-- The restore writes what it resolved into the lock file of the tree. With
         RestoreLockedMode=true it does not write the file: references that the lock file does
         not match stop the restore. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>@WXL_PACKAGES_LOCK_FILE@</NuGetLockFilePath>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <!-- Where CppWinRTMakePlatformProjection and CppWinRTMakeReferenceProjection write the
         headers (cppwinrt.exe -out "$(GeneratedFilesDir)."). -->
    <GeneratedFilesDir>@WXL_PACKAGES_PROJECTION_DIR@\</GeneratedFilesDir>
    <!-- The component projection is for a project that implements runtime classes of its own.
         This one has none, and the target would only write a response file. -->
    <CppWinRTEnableComponentProjection>false</CppWinRTEnableComponentProjection>
  </PropertyGroup>

  <ItemGroup>
@WXL_PACKAGES_REFERENCES@
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
