# ---- The wrappers of a profile, generated by the build ----
#
#   wxl_add_ui_profile(<target> PROFILE <file.winxl-profile> [PARTS <n>] [DOCS <language code>])
#
# The wrappers of <target> -- the classes, the enums and structs, the property
# tags, the schema -- are not in the repository: winui-srcgen writes them from
# the profile and the metadata of the restored packages, and this function makes
# that run a step of the build, so that a fresh clone needs nothing but the
# build itself and the build compiles exactly what the run wrote:
#
#   <build>/wxl.ui/<profile>/wxl/            the headers, <wxl/X.h> through the
#                                            directory above, a PUBLIC include
#                                            directory of <target>; recorded in
#                                            the target property WXL_WRAPPERS_DIR
#   <build>/wxl.ui/<profile>/wxl/parts/      wrapper-00.cpp ... wrapper-<n-1>.cpp,
#                                            the sources of <target>, and
#                                            schema_surface.cpp, the source of
#                                            <target>.surface-test
#
# <profile> is the file's stem (full for full.winxl-profile). In the build
# directory and not in the sources: what is generated belongs to the build that
# generated it -- its packages, its generator -- and two builds of one tree never
# share it. The steps are those of the target <target>.wrappers, which <target>
# and <target>.surface-test depend on, so that every compile and every module
# scan of their sources -- which include the generated headers -- comes after
# them.
#
# What the build can know before the run is what it declares. The parts have
# names fixed by PARTS (default 8: each takes about an eighth of the classes,
# where the controls alone, compiled as one source, are the longest compile of
# the tree), so they are the outputs of the run. The names of the headers come
# from the profile and the metadata, so they are taken from the output
# directory as the last run left it -- a glob, which the build checks again
# before it starts, and configures again when the set changed: after the first
# build, after a run that wrote a header more or less -- and declared as
# by-products of a second step after the run. Ninja then knows what writes
# them, and a source that includes a header the run rewrote is compiled again
# in the same build; undeclared, it would be compiled again only by the next
# one. A step of their own, which only touches its stamp: a header found by a
# new configure has no entry in Ninja's log yet, and as a by-product of the run
# itself it would have Ninja run the generator once more for nothing.
#
# Ninja's restat, which CMake sets on a custom command, keeps the rest as it
# is: the generator writes only the files that changed, so a run that changes
# nothing leaves the parts and the headers, and everything built from them,
# alone. generated.stamp, touched by the last command of the run, is the output
# it always writes.
#
# The command runs again when the generator, a file of the profiles directory or
# the list of the restore (wxl_restored_packages_file(), cmake/wxl_packages.cmake)
# changes. Every file of the profiles directory -- the profiles, types.json,
# fluent-symbols.json -- and not only the profile and what it extends: profiles
# are JSON with comments, which CMake cannot read, so the chain of `extends` is
# not known here.
#
# DOCS writes the metadata's documentation into the headers, in that language
# (winui-srcgen --docs --doc-language), and leaves doc_language.txt beside them
# for the documentation site; the /// comments change no code.
#
# Refused at configure, each with its remedy: no target winui-srcgen (a
# directory configured without the root of the wxl tree, which builds the
# generator), a directory src/wxl beside the caller's CMakeLists.txt (generated
# there by hand, it would shadow the generated headers on the include path
# src/), a profile that does not exist, PARTS outside 1 to 100 (the names of the
# parts have two digits). cmake/wxl_packages.cmake is included before.

include_guard(GLOBAL)

function(wxl_add_ui_profile target)
    cmake_parse_arguments(PARSE_ARGV 1 A "" "PROFILE;PARTS;DOCS" "")
    if(A_UNPARSED_ARGUMENTS OR A_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR
            "wxl_add_ui_profile(${target}): unknown arguments '${A_UNPARSED_ARGUMENTS}' or "
            "keywords without a value '${A_KEYWORDS_MISSING_VALUES}'.")
    endif()

    if(NOT TARGET winui-srcgen)
        message(FATAL_ERROR
            "wxl_add_ui_profile(${target}): there is no target winui-srcgen, which generates the "
            "wrappers: ${CMAKE_CURRENT_SOURCE_DIR} is configured without the wxl tree that builds "
            "it. Configure the root of the wxl tree (tools\\build.ps1, or cmake --preset x64 "
            "there).")
    endif()
    foreach(_wxl_target IN ITEMS "${target}" "${target}.surface-test")
        if(NOT TARGET "${_wxl_target}")
            message(FATAL_ERROR
                "wxl_add_ui_profile(${target}): there is no target ${_wxl_target}; create "
                "${target} and ${target}.surface-test before the wrappers are added to them.")
        endif()
    endforeach()
    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/src/wxl")
        message(FATAL_ERROR
            "wxl_add_ui_profile(${target}): ${CMAKE_CURRENT_SOURCE_DIR}/src/wxl exists: wrappers "
            "generated into the sources, which would be found on the include path "
            "${CMAKE_CURRENT_SOURCE_DIR}/src ahead of the ones this build generates. Delete the "
            "directory; the build generates the wrappers into ${CMAKE_BINARY_DIR}/wxl.ui.")
    endif()
    if(NOT A_PROFILE)
        message(FATAL_ERROR "wxl_add_ui_profile(${target}): no PROFILE.")
    endif()
    cmake_path(ABSOLUTE_PATH A_PROFILE NORMALIZE)
    if(NOT EXISTS "${A_PROFILE}" OR IS_DIRECTORY "${A_PROFILE}")
        message(FATAL_ERROR "wxl_add_ui_profile(${target}): no profile file ${A_PROFILE}.")
    endif()
    if(NOT DEFINED A_PARTS)
        set(A_PARTS 8)
    endif()
    if(NOT A_PARTS MATCHES "^[0-9]+$" OR A_PARTS LESS 1 OR A_PARTS GREATER 100)
        message(FATAL_ERROR
            "wxl_add_ui_profile(${target}): PARTS ${A_PARTS}: the number of parts is from 1 to 100.")
    endif()
    wxl_restored_packages_file(_wxl_packages)
    if(NOT _wxl_packages)
        message(FATAL_ERROR
            "wxl_add_ui_profile(${target}): no list of the restored packages; include "
            "cmake/wxl_packages.cmake before.")
    endif()

    cmake_path(GET A_PROFILE STEM LAST_ONLY _wxl_name)
    cmake_path(GET A_PROFILE PARENT_PATH _wxl_profiles_dir)
    cmake_path(GET CMAKE_CURRENT_FUNCTION_LIST_DIR PARENT_PATH _wxl_tree)
    set(_wxl_root "${CMAKE_BINARY_DIR}/wxl.ui/${_wxl_name}")
    set(_wxl_out "${_wxl_root}/wxl")

    math(EXPR _wxl_last "${A_PARTS} - 1")
    set(_wxl_parts "")
    foreach(_wxl_part RANGE ${_wxl_last})
        if(_wxl_part LESS 10)
            set(_wxl_part "0${_wxl_part}")
        endif()
        list(APPEND _wxl_parts "${_wxl_out}/parts/wrapper-${_wxl_part}.cpp")
    endforeach()
    set(_wxl_surface "${_wxl_out}/parts/schema_surface.cpp")
    set(_wxl_stamp "${_wxl_out}/generated.stamp")

    file(GLOB _wxl_profile_files CONFIGURE_DEPENDS
        "${_wxl_profiles_dir}/*.winxl-profile"
        "${_wxl_profiles_dir}/types.json"
        "${_wxl_profiles_dir}/fluent-symbols.json")
    file(GLOB _wxl_headers CONFIGURE_DEPENDS "${_wxl_out}/*.h")

    set(_wxl_docs "")
    if(DEFINED A_DOCS)
        set(_wxl_docs --docs --doc-language "${A_DOCS}")
    endif()

    add_custom_command(
        OUTPUT ${_wxl_parts} "${_wxl_surface}" "${_wxl_stamp}"
        COMMAND $<TARGET_FILE:winui-srcgen>
                --profile "${A_PROFILE}" --packages "${_wxl_packages}"
                --out "${_wxl_out}" --parts ${A_PARTS} ${_wxl_docs}
        COMMAND "${CMAKE_COMMAND}" -E touch "${_wxl_stamp}"
        DEPENDS winui-srcgen "${A_PROFILE}" ${_wxl_profile_files} "${_wxl_packages}"
        WORKING_DIRECTORY "${_wxl_tree}"
        COMMENT "winui-srcgen: the wrappers of ${_wxl_name} -> ${_wxl_out}"
        VERBATIM)
    set(_wxl_steps "${_wxl_stamp}")
    if(_wxl_headers)
        # The headers, by-products of a step after the run (see above).
        set(_wxl_headers_stamp "${_wxl_out}/headers.stamp")
        add_custom_command(
            OUTPUT "${_wxl_headers_stamp}"
            BYPRODUCTS ${_wxl_headers}
            COMMAND "${CMAKE_COMMAND}" -E touch "${_wxl_headers_stamp}"
            DEPENDS "${_wxl_stamp}"
            VERBATIM)
        list(APPEND _wxl_steps "${_wxl_headers_stamp}")
    endif()
    add_custom_target(${target}.wrappers DEPENDS ${_wxl_steps})

    add_dependencies(${target} ${target}.wrappers)
    add_dependencies(${target}.surface-test ${target}.wrappers)
    target_sources(${target} PRIVATE ${_wxl_parts})
    target_sources(${target}.surface-test PRIVATE "${_wxl_surface}")
    target_include_directories(${target} PUBLIC "$<BUILD_INTERFACE:${_wxl_root}>")
    set_property(TARGET ${target} PROPERTY WXL_WRAPPERS_DIR "${_wxl_out}")

    # The bodies of the controls compiled as one source exceed the 65 279
    # sections of the default object format: MSVC stops with C1128 unless the
    # object is written as /bigobj. On every part, since which classes a part
    # holds, and how many, follows the profile and PARTS.
    set_property(SOURCE ${_wxl_parts} APPEND PROPERTY
        COMPILE_OPTIONS $<$<CXX_COMPILER_ID:MSVC>:/bigobj>)
endfunction()
