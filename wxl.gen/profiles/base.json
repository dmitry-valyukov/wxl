                "Microsoft.UI.Xaml.winmd",
                "Microsoft.UI.Text.winmd"
            ]
        }
    ],
    "windowsMetadata": true,

    "types": {
        "Microsoft.UI.Xaml.Window": {
            "comment": "The window is an implicit root with its whole surface, so no member list here. What it is listed for is the property WinUI3 does not have: a minimum size lives on the window's presenter, three hops away, and a declarative UI has to be able to say it in one word.",
            "syntheticMembers": {
                "MinSize": {
                    "type": "Windows.Graphics.SizeInt32",
                    "function": "impl::set_minimum_size",
                    "include": "../impl/window_constraints.h"
                },
                "Placement": {
                    "comment": "Where the window was last time and how: ordinary, maximized or full-screen, plus the rectangle it returns to. WinUI3 has none of it -- AppWindow gives Position and Size, and a window closed maximized reports the size of the screen, so remembering that hands the reader a monitor-sized window the moment they leave the maximized state. What has to be kept is Win32's restore rectangle. The value is text because that is what an application writes to its settings and hands back unread; reading it back is wxl::window_placement(), a free function, since a property tag is a way of setting and there is no braced form of asking.",
                    "type": "String",
                    "function": "impl::set_window_placement",
                    "include": "../impl/window_placement.h"
                }
            }
        },
        "Microsoft.UI.Xaml.UIElement": {
            "members": [
                "Visibility",
                "Opacity",
                "IsHitTestVisible",
