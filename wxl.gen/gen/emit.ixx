module;

#include <filesystem>
#include <format>
#include <fstream>
#include <iterator>
#include <map>
#include <string>
#include <string_view>
#include <utility>
#include <vector>

// Shared plumbing for the output side of winui-srcgen: opening files,
// the banner every generated file starts with, the record of what was
// written (which the generated CMakeLists.txt is built from), and the
// flat-namespace name registry.
//
// AI note: everything here is deliberately small and free-standing. When
// adding a new kind of output, add a gen/<thing>.cpp with its entry point
// declared in gen/writers.ixx and reuse these helpers rather than opening
// files by hand -- that is what keeps every generated artefact banner-
// tagged and automatically listed in the generated CMakeLists.txt.

export module wxl.gen:emit;

import :md;

export namespace gen {

inline constexpr std::string_view banner =
    "// Generated by winui-srcgen. Do not edit by hand.\n";

// Every generated file passes through here, so a failed open can never
// silently produce nothing -- main() reports the thrown message and exits
// non-zero. std::ofstream keeps the text-mode newline translation the
// generated headers are written with.
std::ofstream open_output(std::filesystem::path const& path);

// What generation produced, in the order it was produced. The generated
// CMakeLists.txt lists exactly these names, so anything written outside
// this record would silently not take part in the build.
class Emitted {
public:
    // `path` is the file just written; only its name is recorded, since
    // the generated CMakeLists.txt sits in the same directory.
    //
    // `target` is which target compiles it, and it is empty for all but one:
    // everything generated belongs to the consuming library, except the
    // schema's own test, which belongs to the surface test beside it. An
    // empty one means the library named by --target.
    void add(std::filesystem::path const& path, std::string_view target = {});

    inline std::vector<std::string> const& files() const noexcept { return files_; }

    // The files of one target, in the order they were written. An empty
    // `target` asks for the ones that named none.
    std::vector<std::string> files_of(std::string_view target) const;

    // Every target some file named, the empty one included, so the
    // CMakeLists writer can walk them without knowing which exist.
    std::vector<std::string> targets() const;

private:
    std::vector<std::string> files_;
    std::vector<std::string> targets_;  // parallel to files_
};

// "Microsoft.UI.Xaml.Controls.Button"
std::string full_name(md::TypeDef const& type);

// The name a WinRT type gets in wxl's flat `namespace wxl`: its bare
// TypeName. Collisions across source namespaces are reported, not
// resolved -- the closures in use haven't produced one.
std::map<md::TypeDef, std::string> build_name_registry(
    std::vector<md::TypeDef> const& types);

// "Content" -> "content", "NavigateUri" -> "navigateUri", "UIElement" ->
// "uiElement": the name a member of a wxl type is written under.
//
// This is what keeps types and members from competing for a name. WinRT
// spells both in PascalCase, so `Margin` would be at once the type of the
// property and the tag the builder syntax assigns to -- and every such pair
// would have to be broken by renaming one of them. Under one convention for
// types (PascalCase) and another for members (camelCase) the question never
// arises: `wxl::Margin` is the type, `margin` is the tag, and neither has to
// give way.
//
// A name that lands on a C++ keyword gets a trailing underscore --
// `Control.Template` is `template_`, `ElementTheme.Default` is `default_`.
std::string member_name(std::string_view metadata_name);

// "IButtonBase" -> "buttonBase_": the Impl field holding that interface,
// matching the validated prototype in sandbox/wxl/impl/interface_cache.cpp.
std::string interface_field_name(std::string_view interface_name);

// "Microsoft.UI.Xaml.Controls" -> "winrt::Microsoft::UI::Xaml::Controls"
std::string winrt_namespace(std::string_view metadata_namespace);

// The cppwinrt projection header a WinRT namespace lives in.
std::string winrt_include(std::string_view metadata_namespace);

}  // namespace gen
