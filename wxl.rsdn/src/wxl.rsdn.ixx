// wxl::rsdn -- разметка RSDN (rsdn.org, клиент Janus) поверх дерева
// wxl.html. Родня wxl.bb: своя только запись тегов и то, чего у BB нет, --
// построчные цитаты с префиксом («AB> так и было»), языковые теги кода
// ([c#], [nemerle]...) с подсветкой, смайлы, адреса прямо в тексте. Всё
// после распознанного тега делает tree_builder семейства.
//
// Правила токенизатора:
//  - перевод строки значим: пост -- плоский текст, \n -> <br>; одиночный
//    перевод сразу за блочным тегом проглатывается;
//  - строка, начинающаяся префиксом с '>' («>», «S>», «АВК>», «·>»), --
//    строка цитаты; сколько стрелок, такова вложенность («CCC>>>» лежит в
//    третьей цитате); подряд идущие складываются в один blockquote, префикс
//    остаётся видимым, как показывает его сам Janus;
//  - [c#]...[/c#] и [code=c#]...[/code] -- один <pre>, и когда язык знает
//    wxl.highlight, куски кода одеты в <span style="kw">, "str", "com";
//    язык, у которого тега на форуме нет (lua, bash, cmake, json), красится
//    только значением [code=...]: голое [lua] -- обычный текст;
//  - смайлы (:) ;) :up: и остальные с форума) -- <img src="smiles/...">
//    с размерами картинки; картинки лежат в wxl.rsdn/smiles, и
//    показывающий их кладёт рядом с разметкой (baseDirectory);
//  - http://, https://, ftp:// и www. в тексте -- ссылка; почта -- нет;
//  - \[ -- буквальная скобка;
//  - незнакомый тег -- буквальный текст;
//  - сущностей нет: & -- просто символ.

export module wxl.rsdn;

import std;
export import wxl.html;
import wxl.core;

export namespace wxl::rsdn {

/// Разбирает разметку RSDN. Не бросает ни на каком входе; восстановления
/// пишутся в document::errors(), как у всего семейства.
html::document parse(std::wstring_view input);

/// То же для проверенного UTF-8.
html::document parse(core::u8_view input);

}  // namespace wxl::rsdn
